{
  "name": "wordsnap-dsh",
  "version": "0.1.0",
  "private": true,
  "description": "Word Snap for DeepSeek Harness: an in-GUI vocabulary matching panel plus agent tools over a shared word library.",
  "license": "MIT",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./client": "./lib/client.js",
    "./library": "./lib/library.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "test": "node --test test/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "vocabulary",
    "word-snap",
    "learning"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Guojiz/word-snap.git",
    "directory": "dsh-plugin"
  }
}
