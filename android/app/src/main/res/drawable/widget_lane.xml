<?xml version="1.0" encoding="utf-8"?>
<!-- Today's goal as a lane that fills coral → gold → mint. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_track" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:startColor="@color/lane_start" android:centerColor="@color/lane_mid"
                    android:endColor="@color/lane_end" android:angle="0" />
                <corners android:radius="5dp" />
            </shape>
        </clip>
    </item>
</layer-list>
