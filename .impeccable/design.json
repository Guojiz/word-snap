  "components": [
    {
      "name": "Match Card",
      "kind": "card",
      "refersTo": "match-card",
      "description": "The board's card: number key plus word; selected, correct and wrong are colour states.",
      "html": "<div class=\"ds-board\"><button class=\"ds-card\"><span class=\"ds-num\">1</span><span class=\"ds-word\">樱桃</span></button><button class=\"ds-card ds-selected\"><span class=\"ds-num\">2</span><span class=\"ds-word\">cherry</span></button><button class=\"ds-card ds-correct\"><span class=\"ds-num\">3</span><span class=\"ds-word\">pear</span></button><button class=\"ds-card ds-wrong\"><span class=\"ds-num\">4</span><span class=\"ds-word\">furor</span></button></div>",
      "css": ".ds-board{display:grid;grid-template-columns:repeat(2,200px);gap:10px;padding:16px;background:var(--bg,#24205a)} .ds-card{height:60px;display:grid;grid-template-columns:40px 1fr;align-items:center;padding:0 16px 0 12px;border:2px solid var(--line,#463f8f);border-radius:14px;color:var(--text,#f3f1ff);background:var(--panel,#2f2a6e);box-shadow:0 6px 16px -6px var(--card-shadow,rgba(5,3,30,.55));cursor:pointer;font:inherit;transition:transform 90ms cubic-bezier(.2,.8,.2,1),border-color 90ms,background 90ms,box-shadow 90ms} .ds-card:hover{border-color:var(--line-strong,#6a62b5);background:var(--panel-soft,#2b2666)} .ds-card:active{transform:translateY(3px);box-shadow:0 3px 16px -6px var(--card-shadow,rgba(5,3,30,.55))} .ds-card:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:2px} .ds-num{font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-weight:700;font-size:16px;color:var(--muted,#b8b2e8)} .ds-word{font-size:21px;font-weight:800;text-align:center} .ds-selected{border-color:var(--blue,#7c5cff);color:var(--selected-ink,#f3f1ff);background:var(--selected-bg,#483a9c)} .ds-correct{border-color:var(--green,#18c6b5);color:var(--correct-ink,#dffcf8);background:var(--correct-bg,#294f7f)} .ds-wrong{border-color:var(--red,#ff5c8a);color:var(--wrong-ink,#ffe4ec);background:var(--wrong-bg,#613675)}"
    },
    {
      "name": "Lane with Combo",
      "kind": "custom",
      "refersTo": "lane-track",
      "description": "Progress lane with beat ticks, one judged segment per match, combo count at the right end.",
      "html": "<div class=\"ds-lane-wrap\"><div class=\"ds-combo\"><b>7</b><span>连击</span></div><div class=\"ds-lane\"><div class=\"ds-fill\"></div></div><span class=\"ds-count\">7/25</span></div>",
      "css": ".ds-lane-wrap{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;position:relative;padding:32px 16px 16px;background:var(--bg,#24205a);width:360px} .ds-lane{position:relative;height:16px;border-radius:999px;overflow:hidden;background:var(--track,#40358e)} .ds-lane::after{content:\"\";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 calc(20% - 2px),rgba(255,255,255,.55) calc(20% - 2px) 20%)} .ds-fill{width:28%;height:100%;border-radius:inherit;background:linear-gradient(90deg,#ffc933 0 30%,#18c6b5 30% 58%,#ffc933 58% 72%,#7ad151 72% 86%,#18c6b5 86% 100%);transition:width 650ms cubic-bezier(.34,1.56,.64,1)} .ds-combo{position:absolute;right:76px;top:4px;display:flex;align-items:baseline;gap:4px;color:var(--text,#f3f1ff);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-weight:800} .ds-combo b{font-size:30px;line-height:1} .ds-combo span{font-size:13px;letter-spacing:.08em} .ds-count{min-width:56px;text-align:right;color:var(--muted,#b8b2e8);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-weight:800;font-size:22px;font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Judgement Chip",
      "kind": "custom",
      "refersTo": "judge-chip",
      "description": "The judgement word over a matched pair, in its ink colour, with reaction time.",
      "html": "<div class=\"ds-judges\"><span class=\"ds-judge ds-perfect\">PERFECT<small>0.8s</small></span><span class=\"ds-judge ds-great\">GREAT<small>1.3s</small></span><span class=\"ds-judge ds-good\">GOOD<small>2.4s</small></span><span class=\"ds-judge ds-miss\">MISS</span></div>",
      "css": ".ds-judges{display:flex;gap:18px;padding:24px;background:var(--bg,#24205a)} .ds-judge{display:inline-flex;align-items:baseline;gap:6px;padding:0 10px;border-radius:12px;background:var(--panel,#2f2a6e);box-shadow:0 10px 24px -8px var(--card-shadow,rgba(5,3,30,.55));font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-size:26px;font-weight:800;letter-spacing:.02em;transform:rotate(-4deg)} .ds-judge small{color:var(--muted,#b8b2e8);font-size:15px} .ds-perfect{color:var(--yellow-ink,#ffd666)} .ds-great{color:var(--green-ink,#5ef0e2)} .ds-good{color:var(--good-ink,#8fe36a)} .ds-miss{color:var(--red-ink,#ff8fb0)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-button fill: lavender on the stage, indigo by day.",
      "html": "<button class=\"ds-btn-primary\">继续</button>",
      "css": ".ds-btn-primary{min-width:150px;height:54px;padding:0 18px;border:0;border-radius:16px;color:var(--on-primary,#24205a);background:var(--primary,#c9c1ff);box-shadow:0 4px 18px -8px var(--card-shadow,rgba(5,3,30,.55));font:inherit;font-size:17px;font-weight:1000;line-height:1.15;cursor:pointer;transition:transform 90ms cubic-bezier(.2,.8,.2,1),box-shadow 90ms,filter 90ms} .ds-btn-primary:hover{filter:brightness(1.03)} .ds-btn-primary:active{transform:translateY(3px);box-shadow:0 1px 18px -8px var(--card-shadow,rgba(5,3,30,.55))} .ds-btn-primary:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Transparent with line outline and violet-ink text.",
      "html": "<button class=\"ds-btn-secondary\">专项练混淆过的词</button>",
      "css": ".ds-btn-secondary{min-width:150px;height:54px;padding:0 18px;border:2px solid var(--line,#463f8f);border-radius:16px;color:var(--blue-ink,#b9a8ff);background:transparent;box-shadow:0 6px 16px -6px var(--card-shadow,rgba(5,3,30,.55));font:inherit;font-size:17px;font-weight:1000;cursor:pointer;transition:transform 90ms cubic-bezier(.2,.8,.2,1)} .ds-btn-secondary:hover{filter:brightness(1.03)} .ds-btn-secondary:active{transform:translateY(3px)} .ds-btn-secondary:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:2px}"
    },
    {
      "name": "Today Line and Streak",
      "kind": "custom",
      "refersTo": "numeral-today",
      "description": "Words left today as a big Saira number; streak chip greyscale until the goal is done, then ember.",
      "html": "<div class=\"ds-today\"><span class=\"ds-today-num\">9</span><span>个词今天要练 · 约 1 分钟</span><span class=\"ds-streak\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M8.6 0C9 2.6 12.5 4.4 12.5 9a4.5 4.5 0 0 1-9 0c0-2 1-3.3 2-4.2-.1 1.4.5 2.5 1.6 2.9C6.8 5.3 7.6 2.5 8.6 0z\"/></svg>0</span><span class=\"ds-streak ds-lit\"><svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\"><path fill=\"currentColor\" d=\"M8.6 0C9 2.6 12.5 4.4 12.5 9a4.5 4.5 0 0 1-9 0c0-2 1-3.3 2-4.2-.1 1.4.5 2.5 1.6 2.9C6.8 5.3 7.6 2.5 8.6 0z\"/></svg>12</span></div>",
      "css": ".ds-today{display:flex;align-items:baseline;gap:4px 10px;padding:16px;color:var(--muted,#b8b2e8);background:var(--bg,#24205a);font-size:15px;font-weight:800} .ds-today-num{color:var(--text,#f3f1ff);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-size:34px;font-weight:800;line-height:.9} .ds-streak{display:inline-flex;align-items:center;gap:3px;margin-left:auto;color:var(--muted,#b8b2e8);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-size:22px;font-weight:800;filter:grayscale(1);opacity:.75;transition:filter .4s,opacity .4s,color .4s} .ds-streak.ds-lit{margin-left:0;color:var(--ember-ink,#ffa45c);filter:none;opacity:1}"
    },
    {
      "name": "Result Block",
      "kind": "custom",
      "refersTo": "display",
      "description": "Set result: CLEAR word, four judgement counts, result line.",
      "html": "<div class=\"ds-result\"><div class=\"ds-clear\">CLEAR</div><div class=\"ds-cells\"><div><b class=\"ds-p\">PERFECT</b><span>9</span></div><div><b class=\"ds-g\">GREAT</b><span>7</span></div><div><b class=\"ds-o\">GOOD</b><span>2</span></div><div><b class=\"ds-m\">MISS</b><span>2</span></div></div><p class=\"ds-line\">最大连击 <b>12</b> · 正确率 <b>90%</b> · 用时 <b>1:35</b></p></div>",
      "css": ".ds-result{width:360px;padding:20px;text-align:center;background:var(--bg,#24205a);color:var(--text,#f3f1ff)} .ds-clear{color:var(--primary,#c9c1ff);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-size:64px;font-weight:800;line-height:1;letter-spacing:.02em;transform:rotate(-4deg)} .ds-cells{display:grid;grid-template-columns:repeat(4,1fr);gap:4px 12px;margin:18px 0 6px;font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-weight:800} .ds-cells div{display:grid;justify-items:center} .ds-cells b{font-size:15px;letter-spacing:.04em} .ds-cells span{font-size:38px;line-height:1.05;font-variant-numeric:tabular-nums} .ds-p{color:var(--yellow-ink,#ffd666)} .ds-g{color:var(--green-ink,#5ef0e2)} .ds-o{color:var(--good-ink,#8fe36a)} .ds-m{color:var(--red-ink,#ff8fb0)} .ds-line{margin:10px 0 0;color:var(--muted,#b8b2e8);font-size:15px;font-weight:700} .ds-line b{color:var(--text,#f3f1ff);font-family:\"Saira Condensed\",\"Arial Narrow\",sans-serif;font-size:20px;font-weight:800}"
    },
    {
      "name": "Filter Chip",
      "kind": "chip",
      "refersTo": "stage-chip-selected",
      "description": "Library stage filters; pressed state is violet.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\" aria-pressed=\"true\">全部 <b>120</b></button><button class=\"ds-chip\" aria-pressed=\"false\">学习中 <b>14</b></button></div>",
      "css": ".ds-chips{display:flex;gap:8px;padding:16px;background:var(--panel,#2f2a6e)} .ds-chip{display:inline-flex;align-items:center;gap:6px;min-height:36px;padding:4px 12px;border:2px solid var(--line,#463f8f);border-radius:999px;color:var(--muted,#b8b2e8);background:var(--bg,#24205a);font:inherit;font-size:14px;font-weight:800;cursor:pointer} .ds-chip b{color:var(--text,#f3f1ff)} .ds-chip:hover{border-color:var(--line-strong,#6a62b5)} .ds-chip:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:2px} .ds-chip[aria-pressed=\"true\"]{border-color:var(--blue,#7c5cff);color:var(--selected-ink,#f3f1ff);background:var(--selected-bg,#483a9c)} .ds-chip[aria-pressed=\"true\"] b{color:inherit}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Ground-colour field, 2px line, violet border and caret on focus.",
      "html": "<label class=\"ds-label\">新词<input class=\"ds-input\" placeholder=\"apple,苹果\"></label>",
      "css": ".ds-label{display:grid;gap:7px;width:320px;padding:16px;background:var(--panel,#2f2a6e);color:var(--muted,#b8b2e8);font-size:14px;font-weight:900} .ds-input{width:100%;padding:12px 13px;border:2px solid var(--line,#463f8f);border-radius:14px;color:var(--text,#f3f1ff);background:var(--bg,#24205a);caret-color:var(--blue,#7c5cff);font:inherit;font-weight:400;outline:none} .ds-input:hover{border-color:var(--line-strong,#6a62b5)} .ds-input:focus{border-color:var(--blue,#7c5cff)} .ds-input:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:1px}"
    },
    {
      "name": "Bottom Navigation",
      "kind": "nav",
      "refersTo": "bottom-nav-item",
      "description": "Phones: five equal buttons in thumb reach; active one in ink colour.",
      "html": "<nav class=\"ds-nav\"><button class=\"ds-nav-btn ds-on\" aria-current=\"page\">练习</button><button class=\"ds-nav-btn\">词库</button><button class=\"ds-nav-btn\">设置</button><button class=\"ds-nav-btn\">外观</button><button class=\"ds-nav-btn\">EN / 中</button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;width:380px;padding:8px 16px;border-top:1px solid var(--line,#463f8f);background:var(--bg,#24205a)} .ds-nav-btn{min-height:44px;padding:6px 4px;border:2px solid var(--line,#463f8f);border-radius:14px;color:var(--muted,#b8b2e8);background:var(--panel-soft,#2b2666);font:inherit;font-size:13px;font-weight:800;cursor:pointer;transition:color 160ms cubic-bezier(.2,.8,.2,1),border-color 160ms} .ds-nav-btn:hover,.ds-nav-btn.ds-on{color:var(--primary,#c9c1ff)} .ds-nav-btn:focus-visible{outline:3px solid var(--blue,#7c5cff);outline-offset:2px}"
    }
  ],
  "narrative": {
    "northStar": "The Rhythm Stage",
    "overview": "Every match is a note landing on a rhythm-game stage. The learner taps a meaning and a word; the pair is judged on the spot (PERFECT, GREAT, GOOD or MISS) from the review engine's own reaction-time grade, the lane at the top fills one judged segment per match, the combo counts up at the lane's right end, and the number of words left today rolls down towards zero. At night the stage is a deep indigo room; by day it is lavender with white cards. The atmosphere comes from the judgement words and the lane, not from decoration.\n\nThe surface is dense and quiet so the board can be loud only when a match lands. One condensed face (Saira Condensed) carries every judgement and every numeral; all running text and every Chinese string stays in the system Chinese face. Colours are states, not decoration: each hue has one meaning everywhere in the app. The look deliberately replaces a borrowed Duolingo arrangement (green, 3D block buttons, mascot cheer): there are no block buttons, no mascot and no green-as-brand.",
    "keyCharacteristics": [
      "Two stages, one world: indigo stage (dark) and lavender day (light), switched by `data-color-mode`, same roles in both.",
      "Hue = meaning: violet chosen, teal correct/GREAT, gold PERFECT, leaf GOOD, rose wrong/MISS, ember a lit day streak.",
      "Indigo-ink buttons, not coloured buttons: the primary action is the stage's own ink (lavender on indigo, indigo on lavender).",
      "Saira Condensed for scoreboard material only (numerals, judgements, result words), rolling digit by digit.",
      "Soft lifted cards, 14px corners, 2px outlines; no hard offset shadows."
    ],
    "rules": [
      {
        "name": "The One Gold Rule",
        "body": "Gold means PERFECT and nothing else. Result words, the combo count, the streak, milestone stars and confetti never turn gold; CLEAR is ink, FULL COMBO is teal, TIME UP is rose, the lit streak is ember.",
        "section": "colors"
      },
      {
        "name": "The Chosen Violet Rule",
        "body": "Violet marks what the learner has chosen or where the keyboard is: the selected card, a pressed filter, the focus ring. It is never a fill for a primary action and never a success colour.",
        "section": "colors"
      },
      {
        "name": "The Ink Variant Rule",
        "body": "Base hues are for outlines, fills and segments; anything read as text uses the matching `-ink` variant for the current mode, which is what holds the 4.5:1 contrast.",
        "section": "colors"
      },
      {
        "name": "The Scoreboard Rule",
        "body": "Saira Condensed is for numerals and the English judgement and result words only. Chinese text, sentences and buttons are never set in it.",
        "section": "typography"
      },
      {
        "name": "The Roll Rule",
        "body": "A number that changes in place (today's remaining, the combo, the trial count, the streak) rolls only its changed digits upward; summary figures count up instead. Numbers never jump.",
        "section": "typography"
      },
      {
        "name": "The Soft Lift Rule",
        "body": "Shadows are blurred, negatively spread and indigo-tinted. No hard offset shadows and no 3D block bottoms under buttons.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** give every state the same hue everywhere: violet chosen, teal correct/GREAT, gold PERFECT, leaf GOOD, rose wrong/MISS, ember lit streak.",
      "**Do** use the `-ink` variant of a hue for any text in it, and check it at 4.5:1 against the surface it sits on in both modes.",
      "**Do** set every numeral and every judgement or result word in Saira Condensed, and roll changed digits rather than replacing the number.",
      "**Do** make the primary action an ink-button fill (lavender on stage, indigo by day) with 16px corners and button lift.",
      "**Do** keep cards and controls at 14px corners with 2px outlines and the soft indigo-tinted lift.",
      "**Do** keep touch targets at 44px or more and show the 3px violet focus ring (2px offset) for keyboard focus.",
      "**Do** keep the judgement word visible when motion is reduced or effects are off; drop only its motion."
    ],
    "donts": [
      "**Don't** use gold for anything but PERFECT: not the combo, the streak, a result word, a warning or a celebration ripple.",
      "**Don't** use violet as a primary-action fill or for success; its only fill is a pressed state (the listen button while it speaks).",
      "**Don't** bring back the borrowed Duolingo look: green as brand colour, 3D block buttons with hard bottom edges, a mascot cheering.",
      "**Don't** set Chinese text or sentences in Saira Condensed.",
      "**Don't** add `text-transform: uppercase` to new components; capitals belong to the judgement and result words, which are written in capitals.",
      "**Don't** hard-code new hex values in components; add a token with both a stage and a day value first."
    ]
